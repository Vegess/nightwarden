# Copy to .env for local runs. On a Hugging Face Space, add these as Secrets / Variables.

# Database. SQLite is fine locally; use Neon Postgres in production
# (postgresql+psycopg2://user:pass@host/db?sslmode=require).
DATABASE_URL=sqlite:///./nightwarden.db

# What to watch: Citebase's API and its METRICS_TOKEN (same value as on Render).
TARGET_NAME=citebase
TARGET_URL=https://documind-intel.onrender.com
TARGET_METRICS_TOKEN=
POLL_INTERVAL_S=60
POLLER_ENABLED=true
DOWN_AFTER_POLLS=3
# Serverless (Vercel): the scheduler calls /api/cron/poll with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# AI triage. Without a key Nightwarden still runs, in rules-only "degraded" mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AGENT_MAX_ROUNDS=6
# Groq's tokens-per-day cap; /usage and /health compare today's triage tokens against it.
GROQ_DAILY_TOKEN_LIMIT=200000
# Optional second AI provider (reported on /health; triage does not use it yet).
BACKUP_LLM_API_KEY=

# Optional: Neon compute hours on /usage (API key + project id from the Neon console).
NEON_API_KEY=
NEON_PROJECT_ID=

# Alerts. Discord or Slack incoming webhook (page, notify, info).
NOTIFY_WEBHOOK_URL=
# Email for pages only, via Brevo's HTTPS API.
BREVO_API_KEY=
MAIL_FROM=
ALERT_EMAIL=
# This dashboard's public URL, used in alert links.
PUBLIC_URL=

# Dead-man switch: pinged after every poll (e.g. a healthchecks.io check URL).
HEARTBEAT_URL=

# Protects POST endpoints (record deploy, fire test event, resolve incident).
ADMIN_TOKEN=

LOG_JSON=false
